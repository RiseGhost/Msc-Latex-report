\oddsidemargin 0.25in \evensidemargin -0.09in  %two-sided
\topmargin -0.2in
\textheight 8.95in
\textwidth  6.05in


\setlength{\parindent}{5mm} \setlength{\parskip}{1mm}
\renewcommand{\baselinestretch}{1.3}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}
\hyphenpenalty=1000
\flushbottom

\def\department#1{\gdef\@department{#1}}
\def\institution#1{\gdef\@institution{#1}}
\def\submitionplace#1{\gdef\@submitionplace{#1}}
\def\submitdate#1{\gdef\@submitdate{#1}}
\def\location#1{\gdef\@location{#1}}
\def\depurl#1{\gdef\@depurl{#1}}
\def\supervisor#1{\gdef\@supervisor{#1}}
\def\submission#1{\gdef\@submission{#1}}
\def\@title{}
\def\@author{}
\def\@department{}
\def\@supervisor{}
\def\@submitdate{}
\def\@location{}
\def\@depurl{}


\def\coverp{%
        \thispagestyle{empty}%
        \begin{figure}[h]
			\includegraphics[width=8cm]{logo1_cor.png}
        \end{figure}

        \null\vskip0.65in%
        \begin{center}
				{\huge \bf \expandafter{\@title}}
                \vskip1in%
                {\Large \bf \@author}\\
				\vskip0.5in%
				{\@submission}\\
				\vskip0.5in%
                {\@supervisor}\\
        \end{center}
        \vfill

        \vfill
        \vskip0.51in%
        \begin{center}
                {\expandafter{\@department}\\
                \expandafter{\@institution}\\
                \expandafter{\@location}\\
				\expandafter{\@depurl}\\
                }
        \end{center}
        \vskip.5in
}

\def\dedicationpage#1{
        \vspace*{12cm}
        \begin{center}
                  {\it #1}
        \end{center}
        \vfill
        }

\def\beforepreface{
        \pagenumbering{roman}
        \pagestyle{plain}
        \coverp
}

\def\afterpreface{%
        \tableofcontents
        \listoffigures
        \pagestyle{headings}
}
